# Copy to .env (git-ignored) and fill in. EnvironmentModel (src/zonic_runtime/config/env.py)
# reads the ZONIC_* variables from here; a variable set in the process environment wins.
# Never commit .env.

ZONIC_ENV=dev

# pgfoundation gateway: AWS Lambda in account 001634074733 (tripleq-development).
# The key is caller zonic-agent-runtime's: PGF_API_KEY_ZONIC_AGENT_RUNTIME in secret
# zonic-postgresql-server/runtime, copy in ZonicPostgresqlServer_FastAPI/.env.lambda.
ZONIC_GATEWAY_BASE_URL=https://sdyvf4y53x524cwgdisy2qyfqy0bgjkm.lambda-url.us-east-1.on.aws
ZONIC_GATEWAY_API_KEY=

# Direct database access, only for SQL tests (uv run pytest -m sql) and scripts/init_db.*.
# Neon project agent-build-langgraph, branch production, database neondb (direct endpoint).
ZONIC_SQL_TEST_DSN=
AGENTRUNTIME_DSN=
AGENTOBSERVABILITY_DSN=
