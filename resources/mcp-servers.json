{
  "defaultExecuteServer": "zonic",
  "servers": {
    "zonic": {
      "url": "env:mcp_base_url",
      "path": "/mcp/",
      "transport": "streamable_http",
      "enabled": true,
      "authSecretRef": "env:mcp_auth_token",
      "maxInFlight": 32,
      "timeoutSeconds": 60,
      "executeTool": "execute"
    }
  }
}
