{
  "schemaVersion": "1.0",
  "builderCommit": "b25bcfcd46ab397ad4f40294a10bbb06fe7f1f35",
  "semantics": {
    "childReference": {
      "workflow": "config.agenticWorkflowId"
    },
    "handoffTargets": {
      "agent": "config.handoffTarget"
    },
    "branches": {
      "rule": {
        "path": "config.rules",
        "idField": "ruleId"
      }
    },
    "entry": {
      "start": true
    },
    "swarms": {
      "swarm": {
        "membersPath": "config.members",
        "entryPointPath": "config.entryPoint",
        "memberTypes": [
          "agent",
          "llm"
        ]
      }
    }
  },
  "conditionOperators": [
    "eq",
    "ne",
    "gt",
    "gte",
    "lt",
    "lte",
    "contains",
    "exists",
    "not_exists"
  ],
  "conditionLogic": [
    "AND",
    "OR"
  ],
  "stateOps": [
    "set",
    "append",
    "extend",
    "merge",
    "increment",
    "remove",
    "clear"
  ],
  "mappingTypes": [
    "string",
    "number",
    "boolean",
    "array",
    "object",
    "variable"
  ],
  "validationRules": {
    "swarm": [
      {
        "id": "SW-1",
        "rule": "non_empty_list",
        "path": "config.members",
        "severity": "error",
        "message": "Swarm node {label}: add at least one member agent"
      },
      {
        "id": "SW-2",
        "rule": "refs_exist",
        "path": "config.members",
        "allowedTypesFrom": "swarms.memberTypes",
        "severity": "error",
        "message": "Swarm node {label}: member {ref} is not an Agent or LLM node"
      },
      {
        "id": "SW-3",
        "rule": "unique_by",
        "path": "config.members",
        "field": "name",
        "severity": "error",
        "message": "Swarm node {label}: two members are named {value}; Strands requires unique agent names"
      },
      {
        "id": "SW-4",
        "rule": "one_of_refs",
        "path": "config.entryPoint",
        "refsPath": "config.members",
        "severity": "error",
        "message": "Swarm node {label}: the entry point is not a member"
      },
      {
        "id": "SW-5",
        "rule": "exclusive_refs",
        "path": "config.members",
        "severity": "error",
        "message": "Node {refLabel} is a member of more than one swarm"
      },
      {
        "id": "SW-6",
        "rule": "no_edges_to_refs",
        "path": "config.members",
        "severity": "error",
        "message": "Edge {edgeId} connects to swarm member {refLabel}; members hand off to each other at run time"
      },
      {
        "id": "SW-7",
        "rule": "each_ref",
        "path": "config.members",
        "check": {
          "rule": "forbidden",
          "path": "config.handoffTarget"
        },
        "severity": "error",
        "message": "Swarm member {refLabel} must not define handoff targets"
      },
      {
        "id": "SW-8",
        "rule": "compare",
        "left": [
          "config.maxHandoffs",
          "config.maxIterations"
        ],
        "op": ">=",
        "right": 1,
        "severity": "error",
        "message": "Swarm node {label}: max handoffs and max iterations must be at least 1"
      },
      {
        "id": "SW-9",
        "rule": "each_ref",
        "path": "config.members",
        "check": {
          "rule": "required",
          "path": "description"
        },
        "severity": "warning",
        "message": "Swarm member {refLabel} has no description; descriptions guide handoff decisions"
      },
      {
        "id": "SW-10",
        "rule": "compare",
        "left": "count(config.members)",
        "op": ">=",
        "right": 2,
        "when": {
          "left": "count(config.members)",
          "op": ">",
          "right": 0
        },
        "severity": "warning",
        "message": "Swarm node {label} has one member, so no handoff can happen"
      },
      {
        "id": "SW-11",
        "rule": "compare",
        "left": "config.repetitiveHandoffMinUniqueAgents",
        "op": "between",
        "right": [
          1,
          "count(config.members)"
        ],
        "when": {
          "left": "config.repetitiveHandoffDetectionWindow",
          "op": ">",
          "right": 0
        },
        "severity": "warning",
        "message": "Swarm node {label}: repetitive handoff detection is only partly configured"
      },
      {
        "id": "SW-12",
        "rule": "compare",
        "left": "config.nodeTimeoutSeconds",
        "op": "<=",
        "right": "config.executionTimeoutSeconds",
        "severity": "warning",
        "message": "Swarm node {label}: the agent timeout is longer than the swarm timeout"
      }
    ]
  },
