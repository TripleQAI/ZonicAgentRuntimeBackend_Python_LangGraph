{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:strands-builder:workflow-document:2",
  "title": "Strands builder workflow document",
  "description": "The workflow JSON the agent runtime executes, version 2. Generated from the node registry: structure and engine paths are enforced; form fields are described in x-form annotations, which validators ignore. Unknown keys are allowed everywhere and survive every round trip.",
  "type": "object",
  "required": [
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Absent means 1.0"
    },
    "agenticWorkflowId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "bpc": {
      "type": "string"
    },
    "editAs": {
      "type": "string"
    },
    "invocationType": {
      "type": "string"
    },
    "appId": {
      "type": "string"
    },
    "moduleId": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "isDisabled": {
      "type": "boolean"
    },
    "isAvailableForMigration": {
      "type": "boolean"
    },
    "enableForAutoInvoke": {
      "type": "boolean"
    },
    "includeThoughts": {
      "type": "boolean"
    },
    "variables": {
      "type": "object",
      "description": "Typed flow variables: { name: { type, default, description } }"
    },
    "interface": {
      "type": "object"
    },
    "security": {
      "type": "object"
    },
    "skills": {
      "type": "array"
    },
    "publishChannels": {
      "type": "array"
    },
    "semanticSearchEnabled": {
      "type": "boolean"
    },
    "semanticDomain": {
      "type": "string"
    },
    "semanticKeywords": {
      "type": "string"
    },
    "semanticUseCases": {
      "type": "string"
    },
    "systemParams": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "runtimeHooks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hookBinding"
      },
      "description": "Version 2.1: the workflow's runtime hook bindings (agent runtime design Section 11)"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "nodeType": {
      "description": "Node types from the registry; filled in by the generator",
      "enum": [
        "start",
        "llm",
        "agent",
        "external_agent",
        "script",
        "http_request",
        "guardrail",
        "rule",
        "workflow",
        "variable",
        "output",
        "approval",
        "human_input",
        "tool",
        "note",
        "view",
        "db_query",
        "swarm"
      ]
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/nodeType"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "config": {
          "type": "object"
        },
        "properties": {
          "type": "object",
          "properties": {
            "hooks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/hookBinding"
              },
              "description": "Version 2.1: hook bindings of this node only (no match)"
            },
            "disabledHooks": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Version 2.1: IDs of overridable workflow or runtime bindings to turn off for this node"
            }
          }
        },
        "variableUpdates": {
          "type": "array"
        },
        "position": {
          "$ref": "#/$defs/point"
        },
        "positionAbsolute": {
          "$ref": "#/$defs/point"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "parentId": {
          "type": "string",
          "description": "Canvas layout only (a Swarm member's container); the runtime ignores it"
        },
        "data": {
          "type": "object"
        },
        "style": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "start"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config.start"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "llm"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config.llm"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "agent"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config.agent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "external_agent"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config.external_agent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "script"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config.script"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "http_request"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config.http_request"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "guardrail"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config.guardrail"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "rule"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config.rule"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "workflow"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config.workflow"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "variable"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config.variable"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "output"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config.output"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "approval"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config.approval"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "human_input"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config.human_input"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "tool"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config.tool"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "note"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config.note"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "view"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config.view"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "db_query"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config.db_query"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "swarm"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/config.swarm"
              }
            }
          }
        }
      ]
    },
    "hookBinding": {
      "type": "object",
      "description": "A runtime hook binding. Hook types, points, modes and failure policies are the builder's hook option sets; config is validated by the runtime per hook type.",
      "required": [
        "id",
        "hook",
        "on"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "hook": {
          "type": "string",
          "minLength": 1
        },
        "on": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "match": {
          "type": "object",
          "properties": {
            "nodeKinds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "nodeTypes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "nodeNames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "workflowIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "when": {
          "type": "object",
          "properties": {
            "conditionLogic": {
              "type": "string"
            },
            "conditions": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "order": {
          "type": "integer"
        },
        "mode": {
          "type": "string"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "failurePolicy": {
          "type": "string"
        },
        "canRoute": {
          "type": "boolean"
        },
        "overridable": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "config": {
          "type": "object"
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "source",
        "target"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "sourceHandle": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetHandle": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": "string"
        },
        "data": {
          "type": "object"
        }
      }
    },
    "config.start": {
      "type": "object",
      "title": "Start",
      "description": "Entry point of the workflow.",
      "properties": {
        "interfaceInputs": {
          "x-form": {
            "widget": "schema_builder",
            "label": "Interface Inputs",
            "description": "Variables passed in when this workflow is invoked."
          }
        },
        "outputStructure": {
          "x-form": {
            "widget": "key_value_list",
            "label": "Fields",
            "description": "Map named output fields from this node's response. Reference downstream as {{nodes.NODE_NAME.output.FIELD_NAME}}."
          }
        },
        "variableUpdates": {
          "x-form": {
            "widget": "state_update_list",
            "label": "Updates",
            "description": "Update workflow variables when this node completes."
          }
        }
      }
    },
    "config.llm": {
      "type": "object",
      "title": "LLM",
      "description": "Calls a large language model with a prompt.",
      "properties": {
        "model": {
          "x-form": {
            "widget": "select",
            "label": "Model",
            "required": true
          }
        },
        "messages": {
          "x-form": {
            "widget": "message_list",
            "label": "Messages"
          }
        },
        "tools": {
          "x-form": {
            "widget": "tool_list",
            "label": "Tools"
          }
        },
        "outputStructure": {
          "x-form": {
            "widget": "key_value_list",
            "label": "Fields",
            "description": "Map named output fields from this node's response. Reference downstream as {{nodes.NODE_NAME.output.FIELD_NAME}}."
          }
        },
        "variableUpdates": {
          "x-form": {
            "widget": "state_update_list",
            "label": "Updates",
            "description": "Update workflow variables when this node completes."
          }
        },
        "responseFormat": {
          "x-form": {
            "widget": "select",
            "label": "Response Format",
            "defaultValue": "text",
            "options": [
              "text",
              "json"
            ]
          }
        },
        "temperature": {
          "x-form": {
            "widget": "number",
            "label": "Temperature",
            "defaultValue": 0.7,
            "min": 0,
            "max": 2,
            "step": 0.1
          }
        },
        "maxTokens": {
          "x-form": {
            "widget": "number",
            "label": "Max Tokens",
            "defaultValue": 1024
          }
        },
        "errorHandling": {
          "x-form": {
            "widget": "switch",
            "label": "Enable Error Handling",
            "defaultValue": false
          }
        }
      }
    },
    "config.agent": {
      "type": "object",
      "title": "Agent",
      "description": "Invokes an agentic loop with tools and a model.",
      "properties": {
        "model": {
          "x-form": {
            "widget": "select",
            "label": "Model",
            "required": true
          }
        },
        "strategy": {
          "x-form": {
            "widget": "select",
            "label": "Agent Strategy",
            "defaultValue": "react",
            "options": [
              "react",
              "plan_exec",
              "custom"
            ]
          }
        },
        "systemPrompt": {
          "x-form": {
            "widget": "markdown",
            "label": "System Prompt"
          }
        },
        "tools": {
          "x-form": {
            "widget": "tool_list",
            "label": "Tools"
          }
        },
        "handoffTarget": {
          "x-form": {
            "widget": "node_multiselect",
            "label": "Handoff Targets",
            "description": "When this agent completes, hand off execution to each selected node."
          },
          "type": [
            "array",
            "null"
          ]
        },
        "outputStructure": {
          "x-form": {
            "widget": "key_value_list",
            "label": "Fields",
            "description": "Map named output fields from this node's response. Reference downstream as {{nodes.NODE_NAME.output.FIELD_NAME}}."
          }
        },
        "variableUpdates": {
          "x-form": {
            "widget": "state_update_list",
            "label": "Updates",
            "description": "Update workflow variables when this node completes."
          }
        },
        "maxIterations": {
          "x-form": {
            "widget": "number",
            "label": "Max Iterations",
            "defaultValue": 10
          }
        },
        "includeThoughts": {
          "x-form": {
            "widget": "switch",
            "label": "Include Thoughts",
            "defaultValue": false
          }
        }
      }
    },
    "config.external_agent": {
      "type": "object",
      "title": "External Agent",
      "description": "Calls an agent hosted externally via HTTP.",
      "properties": {
        "endpoint": {
          "x-form": {
            "widget": "expression",
            "label": "Endpoint URL",
            "description": "Full URL of the external agent endpoint.",
            "required": true
          }
        },
        "authType": {
          "x-form": {
            "widget": "select",
            "label": "Auth Type",
            "defaultValue": "none",
            "options": [
              "none",
              "bearer",
              "apikey",
              "basic"
            ]
          }
        },
        "apiKey": {
          "x-form": {
            "widget": "expression",
            "label": "API Key / Token",
            "description": "Supports variable references, e.g. {{secrets.myKey}}"
          }
        },
        "inputMapping": {
          "x-form": {
            "widget": "mapping_list",
            "label": "Input Fields"
          }
        },
        "outputStructure": {
          "x-form": {
            "widget": "key_value_list",
            "label": "Fields",
            "description": "Map named output fields from this node's response. Reference downstream as {{nodes.NODE_NAME.output.FIELD_NAME}}."
          }
        },
        "variableUpdates": {
          "x-form": {
            "widget": "state_update_list",
            "label": "Updates",
            "description": "Update workflow variables when this node completes."
          }
        },
        "timeoutSeconds": {
          "x-form": {
            "widget": "number",
            "label": "Timeout (seconds)",
            "defaultValue": 30
          }
        },
        "retries": {
          "x-form": {
            "widget": "number",
            "label": "Retries",
            "defaultValue": 0
          }
        }
      }
    },
    "config.script": {
      "type": "object",
      "title": "Script",
      "description": "Runs a custom JavaScript or Python snippet.",
      "properties": {
        "inputs": {
          "x-form": {
            "widget": "mapping_list",
            "label": "Input Mapping",
            "description": "Mapped variables are accessible in the code as input.key — e.g. input.queryResponse."
          }
        },
        "language": {
          "x-form": {
            "widget": "select",
            "label": "Language",
            "required": true,
            "defaultValue": "javascript",
            "options": [
              "javascript",
              "python",
              "typescript"
            ]
          }
        },
        "code": {
          "x-form": {
            "widget": "code",
            "label": "Code",
            "required": true
          }
        },
        "outputStructure": {
          "x-form": {
            "widget": "key_value_list",
            "label": "Fields",
            "description": "Map named output fields from this node's response. Reference downstream as {{nodes.NODE_NAME.output.FIELD_NAME}}."
          }
        },
        "variableUpdates": {
          "x-form": {
            "widget": "state_update_list",
            "label": "Updates",
            "description": "Update workflow variables when this node completes."
          }
        }
      }
    },
    "config.http_request": {
      "type": "object",
      "title": "HTTP Request",
      "description": "Makes an outbound HTTP request.",
      "properties": {
        "method": {
          "x-form": {
            "widget": "select",
            "label": "Method",
            "required": true,
            "defaultValue": "GET",
            "options": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          }
        },
        "url": {
          "x-form": {
            "widget": "expression",
            "label": "URL",
            "description": "Supports variable references in the URL.",
            "required": true
          }
        },
        "headers": {
          "x-form": {
            "widget": "key_value_list",
            "label": "Request Headers"
          }
        },
        "body": {
          "x-form": {
            "widget": "expression",
            "label": "Request Body",
            "description": "Supports variable references."
          }
        },
        "outputStructure": {
          "x-form": {
            "widget": "key_value_list",
            "label": "Fields",
            "description": "Map named output fields from this node's response. Reference downstream as {{nodes.NODE_NAME.output.FIELD_NAME}}."
          }
        },
        "variableUpdates": {
          "x-form": {
            "widget": "state_update_list",
            "label": "Updates",
            "description": "Update workflow variables when this node completes."
          }
        },
        "timeoutSeconds": {
          "x-form": {
            "widget": "number",
            "label": "Timeout (seconds)",
            "defaultValue": 30
          }
        }
      }
    },
    "config.guardrail": {
      "type": "object",
      "title": "Guardrail",
      "description": "Enforces safety or policy constraints on the flow.",
      "properties": {
        "inputMapping": {
          "x-form": {
            "widget": "mapping_list",
            "label": "Input Mapping"
          }
        },
        "policy": {
          "x-form": {
            "widget": "textarea",
            "label": "Policy / Rules",
            "required": true
          }
        },
        "action": {
          "x-form": {
            "widget": "select",
            "label": "On Fail",
            "required": true,
            "defaultValue": "block",
            "options": [
              "block",
              "warn",
              "redirect"
            ]
          }
        },
        "outputStructure": {
          "x-form": {
            "widget": "key_value_list",
            "label": "Fields",
