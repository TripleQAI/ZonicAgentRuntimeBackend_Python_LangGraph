{
  "schemaVersion": "2.0",
  "agenticWorkflowId": "synthetic-routing-handoff",
  "name": "routing-handoff",
  "displayName": "Routing Handoff",
  "description": "An agent that hands off to one of two LLM nodes through handoff edges; both join at Output.",
  "variables": {},
  "systemParams": [],
  "publishChannels": [],
