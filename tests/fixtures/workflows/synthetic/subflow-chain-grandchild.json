      "name": "Start_1",
      "description": "",
      "config": {
        "interfaceInputs": [],
        "variableUpdates": []
      }
    },
    {
      "id": "llm_1",
      "type": "llm",
      "name": "LLM_1",
      "description": "",
      "config": {
