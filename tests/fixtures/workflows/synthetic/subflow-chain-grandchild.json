{
  "schemaVersion": "2.0",
  "agenticWorkflowId": "synthetic-subflow-chain-grandchild",
  "name": "subflow-chain-grandchild",
  "displayName": "Subflow Chain Grandchild",
  "description": "Leaf of the chain: one LLM answer.",
  "variables": {},
  "systemParams": [],
  "publishChannels": [],
  "nodes": [
    {
      "id": "start_1",
