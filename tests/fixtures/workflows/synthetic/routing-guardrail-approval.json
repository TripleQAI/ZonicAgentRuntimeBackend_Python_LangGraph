{
  "schemaVersion": "2.0",
  "agenticWorkflowId": "synthetic-routing-guardrail-approval",
  "name": "routing-guardrail-approval",
  "displayName": "Routing Guardrail Approval",
  "description": "Guardrail pass and fail, then an approval with approved and rejected branches.",
  "variables": {},
  "systemParams": [],
  "publishChannels": [],
  "nodes": [
    {
      "id": "start_1",
      "type": "start",
      "name": "Start_1",
      "description": "",
      "config": {
        "interfaceInputs": [],
        "variableUpdates": []
      }
    },
    {
      "id": "guardrail_1",
      "type": "guardrail",
      "name": "Guardrail_1",
      "description": "",
      "config": {
        "inputMapping": [
          {
            "key": "text",
            "value": "{{system.userQuery}}",
            "type": "string"
          }
        ],
        "policy": "Allow questions about facilities only.",
        "action": "block",
        "outputSchema": [],
        "stateUpdates": [],
        "variableUpdates": []
      }
    },
    {
      "id": "llm_1",
      "type": "llm",
      "name": "LLM_1",
      "description": "",
      "config": {
        "model": "claude-haiku-4-5",
        "messages": [
          {
            "role": "system",
            "content": "Draft an answer."
          },
          {
            "role": "user",
            "content": "{{system.userQuery}}"
          }
        ],
        "tools": [],
        "responseFormat": "text",
        "temperature": 0.2,
        "maxTokens": 512,
        "outputSchema": [],
        "stateUpdates": [],
        "variableUpdates": []
      }
    },
    {
      "id": "approval_1",
      "type": "approval",
      "name": "Approval_1",
      "description": "",
      "config": {
        "message": "Publish {{nodes.LLM_1.output.result}}?",
        "approvers": [],
        "timeoutHours": 24,
        "responseVariable": "approval.response",
        "outputSchema": [],
        "stateUpdates": [],
        "variableUpdates": []
      }
    },
    {
      "id": "output_approved",
      "type": "output",
      "name": "Approved",
      "description": "",
      "config": {
        "outputMapping": [
          {
            "target": "answer",
            "source": "{{nodes.LLM_1.output.result}}",
            "type": "string"
          }
        ],
        "variableUpdates": []
      }
    },
    {
      "id": "output_rejected",
      "type": "output",
      "name": "Rejected",
      "description": "",
      "config": {
        "outputMapping": [
          {
            "target": "answer",
            "source": "rejected",
            "type": "string"
          }
        ],
        "variableUpdates": []
      }
    },
    {
      "id": "output_refused",
      "type": "output",
      "name": "Refused",
      "description": "",
      "config": {
        "outputMapping": [
          {
            "target": "answer",
            "source": "refused",
            "type": "string"
          }
        ],
        "variableUpdates": []
      }
    }
  ],
  "edges": [
    {
      "id": "e_start_1_default_guardrail_1",
      "source": "start_1",
