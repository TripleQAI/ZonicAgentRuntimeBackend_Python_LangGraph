      "type": "boolean"
    },
    "comment": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Comment"
    },
    "decidedBy": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "readOnly": true,
      "title": "Decidedby"
    },
    "expired": {
      "default": false,
      "readOnly": true,
      "title": "Expired",
      "type": "boolean"
    }
  },
  "required": [
