          "default": null,
          "title": "Refspath"
        },
        "right": {
          "default": null,
          "title": "Right"
        },
        "rule": {
          "enum": [
            "non_empty_list",
            "required",
            "forbidden",
            "refs_exist",
            "unique_by",
            "one_of_refs",
            "exclusive_refs",
            "no_edges_to_refs",
            "each_ref",
            "compare"
