{
  "$defs": {
    "Condition": {
      "additionalProperties": true,
      "description": "One comparison of a rule branch or a conditional update.",
      "properties": {
        "field": {
          "default": null,
          "title": "Field"
        },
        "logic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logic"
        },
        "op": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Op"
        },
        "operator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operator"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "title": "Condition",
      "type": "object"
    },
    "ConditionGroup": {
      "additionalProperties": true,
      "description": "Conditions joined by ``AND`` or ``OR``: an update's ``when``.",
      "properties": {
        "conditionLogic": {
          "default": "AND",
          "title": "Conditionlogic",
          "type": "string"
        },
        "conditions": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "title": "Conditions",
          "type": "array"
        }
      },
      "title": "ConditionGroup",
      "type": "object"
    },
    "HookBinding": {
      "additionalProperties": false,
      "properties": {
        "canRoute": {
          "default": false,
          "title": "Canroute",
          "type": "boolean"
        },
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "failurePolicy": {
          "default": "fail_node",
          "enum": [
            "fail_node",
            "fail_run",
            "ignore"
          ],
          "title": "Failurepolicy",
          "type": "string"
        },
        "hook": {
          "minLength": 1,
          "title": "Hook",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "match": {
          "$ref": "#/$defs/HookMatch"
        },
        "mode": {
          "default": "blocking",
          "enum": [
            "blocking",
            "async"
          ],
          "title": "Mode",
          "type": "string"
        },
        "on": {
          "items": {
            "enum": [
              "beforeRun",
              "afterRun",
              "onRunError",
              "beforeNode",
              "afterNode",
              "onNodeError",
              "beforeModelCall",
              "afterModelCall",
              "beforeToolCall",
              "afterToolCall",
              "beforeMemberCall",
              "onHandoff",
              "onInterrupt",
              "onResume"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "On",
          "type": "array"
        },
        "order": {
          "default": 100,
          "title": "Order",
          "type": "integer"
        },
        "overridable": {
          "default": true,
          "title": "Overridable",
          "type": "boolean"
        },
        "timeoutMs": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeoutms"
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionGroup"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "hook",
        "on"
      ],
      "title": "HookBinding",
      "type": "object"
    },
    "HookMatch": {
      "additionalProperties": false,
      "properties": {
        "nodeKinds": {
          "items": {
            "type": "string"
          },
          "title": "Nodekinds",
          "type": "array"
        },
        "nodeNames": {
          "items": {
            "type": "string"
          },
          "title": "Nodenames",
          "type": "array"
        },
        "nodeTypes": {
          "items": {
            "type": "string"
          },
          "title": "Nodetypes",
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "workflowIds": {
          "items": {
            "type": "string"
          },
          "title": "Workflowids",
          "type": "array"
        }
      },
      "title": "HookMatch",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bindings": {
      "items": {
        "$ref": "#/$defs/HookBinding"
      },
      "title": "Bindings",
      "type": "array"
    }
  },
  "title": "HookBindings",
  "type": "object"
}
